# define the sampler $plugname with schema $testname on producers $minsamp-$maxsamp
plugins:
  ${plugname}:
    name: ${plugname}
    interval: "1s"
    config:
    - producer: "localhost${i}"
      schema: ${testname}
      instance: localhost${i}/${testname}
      component_id: "${i}"
      perm: "0644"

samplers:
- daemons: "localhost[@minsamp@-@maxsamp@]"
  plugins: [ "${plugname}" ]
