export plugname=stream_store
portbase=61020
DAEMONS 1
echo '{"job-id" : 10364, "rank" : 1, "kokkos-perf-data" : [ {"name" : "SPARTAFOO0", "count": 0, "time": 0.0000}] }' > $LDMSD_RUN/x.json
VGARGS="--leak-check=full --show-leak-kinds=definite --track-origins=yes --trace-children=yes"
vgon
LDMSD 1
vgoff
SLEEP 2
/bin/rm -f $STOREDIR/publog.* csv
calls=1
pubargs="-p $port1 -a none -s foo -t json -x sock -h localhost -i 0.001 -r $calls -l -f $LDMSD_RUN/x.json > $STOREDIR/publog"
echo "run $pubargs"
#gdb ldmsd_stream_publish
count=1
echo $(($calls * $count))
MESSAGE publishing $count
for i in $(seq $count); do
	SLEEP 0.0001
	ldmsd_stream_publish $pubargs.$i &
done
MESSAGE ps report count:
ps guxw |grep ldmsd_stream_publish |wc -l

SLEEP 5
KILL_LDMSD 1
file_created $STOREDIR/csv/foo.*
MESSAGE events captured+header
wc -l $STOREDIR/csv/foo.*
