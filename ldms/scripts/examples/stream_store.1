#config name=stream_csv_store path=${STOREDIR} container=csv stream=foo buffer=1 rolltype=3 rollover=50
# 4 works for longer times (due to fixed internal sleep between count checks)
#config name=stream_csv_store path=${STOREDIR} container=csv stream=foo buffer=1 rolltype=4 rollover=5000
# 2 works
# config name=stream_csv_store path=${STOREDIR} container=csv stream=foo,bar,baz buffer=1 rolltype=1 rollover=2
# 5 works
#config name=stream_csv_store path=${STOREDIR} container=csv stream=foo buffer=1 rolltype=5 rollover=2 rollagain=10
